{
  "name": "delego",
  "version": "0.0.1",
  "private": true,
  "description": "Frontend web application for the Delego AI commerce platform",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @delegolabs/web dev",
    "dev:web": "pnpm --filter @delegolabs/web dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "clean": "pnpm -r exec rm -rf dist .next node_modules",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@types/node": "^25.9.3",
    "husky": "^9.1.7"
  },
  "pnpm": {
    "overrides": {
      "axios": ">=1.16.0"
    }
  }
}
